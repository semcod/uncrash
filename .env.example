ENV_DSL_VERSION=1
ENV_DSL_NAMESPACE=UNCRASH
ENV_DSL_ENVIRONMENT=BASE

# Literal deployment constants; never source or evaluate this file as shell code.
# Extend BASE in the selected private .env using ENV_DSL_ENVIRONMENT=LOCAL
# and ENV_DSL_EXTENDS=BASE; no credentials belong in this document.

UNCRASH_ENCRYPT=false
UNCRASH_COMPRESS=false
UNCRASH_SNAPSHOT_ENGINE=rust
UNCRASH_RUST_THREADS=4
# Optional explicit worker binary: UNCRASH_RUST_BINARY=/absolute/path/to/uncrash-snapshot
UNCRASH_INTERVAL_SECONDS=300
UNCRASH_RETENTION=288
UNCRASH_RETENTION_AGE_SECONDS=86400
UNCRASH_RETENTION_CHECK_SECONDS=60
UNCRASH_MAX_FILE_BYTES=536870912
UNCRASH_MAX_BYTES=17179869184
UNCRASH_MAX_TOTAL_BYTES=34359738368
UNCRASH_STARTUP_RESTORE=false
UNCRASH_JETBRAINS_METADATA=false
UNCRASH_STATE_DIR=~/.local/state/uncrash
UNCRASH_CONFIG_FILE=~/.config/uncrash/config.json
UNCRASH_API_HOST=127.0.0.1
UNCRASH_API_PORT=8795
UNCRASH_MCP_HOST=127.0.0.1
UNCRASH_MCP_PORT=18795
UNCRASH_MCP_TRANSPORT=stdio
UNCRASH_PREVIEW_HOST=127.0.0.1
UNCRASH_PREVIEW_WIDTH=1280
UNCRASH_PREVIEW_HEIGHT=800
UNCRASH_PREVIEW_DISPLAY_START=150
UNCRASH_PREVIEW_DISPLAY_END=400
UNCRASH_NOVNC_ASSETS=/usr/share/novnc
UNCRASH_TWINERD_NATIVE_PATH=~/github/twinerd/twinerd/packages/twinerd-mcp
UNCRASH_TWINERD_KASM_PATH=~/github/twinerd/twinerd/packages/twinerd-kasm
UNCRASH_CLONEBOX_PATH=~/github/wronai/clonebox/src
UNCRASH_PELORUS_PATH=~/github/twinerd/twinerd/packages/twinerd-pelorus
UNCRASH_HEALTH_MAX_AGE_SECONDS=600
UNCRASH_TRANSFER_TIMEOUT_SECONDS=600
UNCRASH_NATIVE_BUILD_TIMEOUT_SECONDS=120
UNCRASH_NATIVE_CAPTURE_TIMEOUT_SECONDS=600
UNCRASH_SQLITE_BACKUP_TIMEOUT_SECONDS=10
UNCRASH_LOG_MAX_HOURLY_BYTES=4194304
